@model Assignment_2.Models.Monster

<div class="monster-form-section">
    <h3>Ability Scores</h3>
    <p class="form-help">Enter the six ability scores for the monster.</p>
    <div class="ability-form-grid">
        <div>
            <label asp-for="Strength" class="form-label">STR</label>
            <input asp-for="Strength" class="form-control" />
        </div>
        <div>
            <label asp-for="Dexterity" class="form-label">DEX</label>
            <input asp-for="Dexterity" class="form-control" />
        </div>
        <div>
            <label asp-for="Constitution" class="form-label">CON</label>
            <input asp-for="Constitution" class="form-control" />
        </div>
        <div>
            <label asp-for="Intelligence" class="form-label">INT</label>
            <input asp-for="Intelligence" class="form-control" />
        </div>
        <div>
            <label asp-for="Wisdom" class="form-label">WIS</label>
            <input asp-for="Wisdom" class="form-control" />
        </div>
        <div>
            <label asp-for="Charisma" class="form-label">CHA</label>
            <input asp-for="Charisma" class="form-control" />
        </div>
    </div>
</div>
