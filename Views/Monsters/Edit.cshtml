@model Assignment_2.Models.Monster

@{
    ViewData["Title"] = "Edit Monster";
    ViewData["ShowCurrentHealth"] = true;
}

<div class="monster-form">
    <div class="monster-form-header">
        <span class="eyebrow">MONSTER LIBRARY</span>
        <h1>Edit @Model.Name</h1>
        <p>Update this monster's statistics and information.</p>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @await Html.PartialAsync("_BasicInfoFields", Model)
        @await Html.PartialAsync("_AbilityScoreInputs", Model)

        <div class="monster-form-section">
            <h3>Description</h3>
            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
        </div>

        <div class="monster-form-actions">
            <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
